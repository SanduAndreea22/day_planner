# Copy to .env and fill in real values. .env is gitignored and loaded automatically.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Leave empty to use local SQLite.
DATABASE_URL=


# Error monitoring — a no-op until set (e.g. once a free Sentry project exists).
SENTRY_DSN=
