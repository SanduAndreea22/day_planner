# Copy to .env and fill in real values. .env is gitignored and loaded automatically.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Leave empty to use local SQLite.
DATABASE_URL=

# Email — leave EMAIL_HOST empty to print emails to the console instead
# (fine for local dev; password reset and evening reminders still "work").
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Brevo (Sendinblue) API key, used by the evening-reminder email job.
BREVO_API_KEY=

# Shared secret the GitHub Actions cron job sends to authorize
# /tasks/send-evening-reminders/. Leave empty locally.
TASK_SECRET=

# Error monitoring — a no-op until set (e.g. once a free Sentry project exists).
SENTRY_DSN=
